# Copy this file to .env and fill in your own values. .env is never committed.

# Required: https://console.groq.com/keys
GROQ_API_KEY=

# Required to save drafts: the Gmail account you send outreach from.
# App password: https://myaccount.google.com/apppasswords (needs 2-Step Verification on that account)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: Apollo.io key for verified founder / HR emails (1 credit per company)
APOLLO_API_KEY=

# Optional: https://serper.dev key for reliable LinkedIn / X hiring-post search
SERPER_API_KEY=

# Optional tuning. Defaults match Groq's free tier (200K tokens/day per model).
# GROQ_MODEL_SMART=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_DAILY_TOKENS=180000
